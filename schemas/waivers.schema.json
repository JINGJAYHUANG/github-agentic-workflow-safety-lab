{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JINGJAYHUANG/github-agentic-workflow-safety-lab/schemas/waivers.schema.json",
  "title": "GAWSL waivers",
  "type": "object",
  "required": ["schema_version", "waivers"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "path", "reason", "expires_at"],
        "properties": {
          "rule_id": {"pattern": "^(GH|AG)[0-9]{3}$"},
          "path": {"type": "string", "minLength": 1},
          "fingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "reason": {"type": "string", "minLength": 10},
          "expires_at": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
